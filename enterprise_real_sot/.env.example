# ==============================================================================
# NETWORK AUTOMATION PLATFORM (N/W AP) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with valid environment values.
# DO NOT commit '.env' containing real secrets to Git.

# ------------------------------------------------------------------------------
# 1. NetBox REST API Connection Settings
# ------------------------------------------------------------------------------
NETBOX_URL=http://localhost:8000/api/
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567

# ------------------------------------------------------------------------------
# 2. Global Default SSH Credentials for Network Devices
# ------------------------------------------------------------------------------
SSH_USERNAME=admin
SSH_PASSWORD=your_ssh_password_here
SSH_SECRET=your_enable_secret_here

# ------------------------------------------------------------------------------
# 3. Transport & Connection Timeouts
# ------------------------------------------------------------------------------
SSH_PORT=22
SSH_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. Device Group / Profile Credentials (Optional Overrides)
# ------------------------------------------------------------------------------
# Access Switches
SSH_ACCESS_USERNAME=admin
SSH_ACCESS_PASSWORD=access_password_here
SSH_ACCESS_SECRET=access_secret_here

# Core Switches / Routers
SSH_CORE_USERNAME=admin
SSH_CORE_PASSWORD=core_password_here
SSH_CORE_SECRET=core_secret_here
