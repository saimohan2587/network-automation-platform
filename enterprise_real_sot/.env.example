# NetBox Connection Settings
NETBOX_URL=http://localhost:8000/api/
NETBOX_TOKEN=your_netbox_token_here

# Global Default SSH Credentials
SSH_USERNAME=admin
SSH_PASSWORD=your_password_here
SSH_SECRET=your_secret_here

# Profile-Specific Credentials Example (Access Switches)
SSH_ACCESS_USERNAME=admin
SSH_ACCESS_PASSWORD=access_switch_password
SSH_ACCESS_SECRET=access_switch_secret

# Profile-Specific Credentials Example (Core Switches)
SSH_CORE_USERNAME=admin
SSH_CORE_PASSWORD=core_switch_password
SSH_CORE_SECRET=core_switch_secret

# Transport Parameters
SSH_PORT=22
SSH_TIMEOUT=30

# Device-Specific Credentials Example (sw-access-07)
SSH_SW_ACCESS_07_USERNAME=your_device_username_here
SSH_SW_ACCESS_07_PASSWORD=your_device_password_here
