# ==============================================================================
# NETWORK AUTOMATION PLATFORM (N/W AP) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with valid environment values.
# DO NOT commit '.env' containing real secrets to Git.

# ------------------------------------------------------------------------------
# 1. NetBox REST API Connection Settings
# ------------------------------------------------------------------------------
NETBOX_URL=http://localhost:8000/api/
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567

# ------------------------------------------------------------------------------
# 2. Global Default SSH Credentials for Network Devices
# ------------------------------------------------------------------------------
SSH_USERNAME=admin
SSH_PASSWORD=your_ssh_password_here
SSH_SECRET=your_enable_secret_here

# ------------------------------------------------------------------------------
# 3. Transport & Connection Timeouts
# ------------------------------------------------------------------------------
SSH_PORT=22
SSH_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. Device Group / Profile Credentials (Optional Overrides)
# ------------------------------------------------------------------------------
# Access Switches
SSH_ACCESS_USERNAME=admin
SSH_ACCESS_PASSWORD=access_password_here
SSH_ACCESS_SECRET=access_secret_here

# Core Switches / Routers
SSH_CORE_USERNAME=admin
SSH_CORE_PASSWORD=core_password_here
SSH_CORE_SECRET=core_secret_here

# Device-specific override example (SSH_<DEVICE_NAME_UPPERCASE>_USERNAME/PASSWORD)
# SSH_SW_ACCESS_07_USERNAME=
# SSH_SW_ACCESS_07_PASSWORD=

# ------------------------------------------------------------------------------
# 5. ServiceNow REST API Connection Settings
# ------------------------------------------------------------------------------
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_MOCK_MODE=true
SERVICENOW_TIMEOUT=60

# sys_id of the ServiceNow user/service account incident payloads are filed
# under (was previously hardcoded in servicenow/models/incident_payload.py)
SERVICENOW_CALLER_ID_SYS_ID=

# ------------------------------------------------------------------------------
# 6. SNMP Monitoring (Prometheus snmp_exporter)
# ------------------------------------------------------------------------------
# Staging: SNMPv2c community string is acceptable for an isolated GNS3 lab.
# Production: migrate to SNMPv3 (per-device auth/priv credentials) - see
# docs/SECURITY_HARDENING_REPORT.md, Section 5.
SNMP_COMMUNITY=

# ------------------------------------------------------------------------------
# 7. Grafana Admin Console
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 8. ServiceNow Webhook Adapter
# ------------------------------------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
# Used by maintenance_mode.py (host-side CLI) to reach the adapter's HTTP API.
SERVICENOW_ADAPTER_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 9. Maintenance Mode / Monitoring Suppression
# ------------------------------------------------------------------------------
MAINTENANCE_DEFAULT_DURATION=4h
DEVICE_STARTUP_GRACE_PERIOD=300
