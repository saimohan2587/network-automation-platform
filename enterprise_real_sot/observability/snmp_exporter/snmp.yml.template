# ==============================================================================
# Prometheus SNMP Exporter Configuration - Cisco IOS / IOSvL2 Devices
# ==============================================================================

auths:
  public_v2:
    community: ${SNMP_COMMUNITY}
    version: 2

modules:
  cisco_ios:
    walk:
      - 1.3.6.1.2.1.1.3.0       # sysUpTime
      - 1.3.6.1.2.1.1.5.0       # sysName
      - 1.3.6.1.4.1.9.2.1.56.0  # busyPer (CPU 5-min avg)
      - 1.3.6.1.4.1.9.2.1.8.0   # freeMem (Free Memory in Bytes)
      - 1.3.6.1.4.1.9.2.1.9.0   # allocMem (Used Memory in Bytes)
      - 1.3.6.1.2.1.2.2.1.7     # ifAdminStatus
      - 1.3.6.1.2.1.2.2.1.8     # ifOperStatus
      - 1.3.6.1.2.1.2.2.1.14    # ifInErrors
      - 1.3.6.1.2.1.2.2.1.20    # ifOutErrors
    metrics:
      - name: sysUpTime
        oid: 1.3.6.1.2.1.1.3.0
        type: gauge
        help: "System uptime in hundredths of a second"

      - name: sysName
        oid: 1.3.6.1.2.1.1.5.0
        type: DisplayString
        help: "An administratively-assigned name for this managed node"

      - name: cisco_cpu_utilization_percent
        oid: 1.3.6.1.4.1.9.2.1.56.0
        type: gauge
        help: "Cisco CPU utilization percent (5 minute average)"

      - name: cisco_memory_free_bytes
        oid: 1.3.6.1.4.1.9.2.1.8.0
        type: gauge
        help: "Cisco memory pool free bytes"

      - name: cisco_memory_used_bytes
        oid: 1.3.6.1.4.1.9.2.1.9.0
        type: gauge
        help: "Cisco memory pool used bytes"

      - name: ifAdminStatus
        oid: 1.3.6.1.2.1.2.2.1.7
        type: gauge
        help: "The desired state of the interface (1=up, 2=down, 3=testing)"
        indexes:
          - labelname: ifIndex
            type: Integer32

      - name: ifOperStatus
        oid: 1.3.6.1.2.1.2.2.1.8
        type: gauge
        help: "The current operational state of the interface (1=up, 2=down)"
        indexes:
          - labelname: ifIndex
            type: Integer32

      - name: ifInErrors
        oid: 1.3.6.1.2.1.2.2.1.14
        type: counter
        help: "The number of inbound packets that contained errors"
        indexes:
          - labelname: ifIndex
            type: Integer32

      - name: ifOutErrors
        oid: 1.3.6.1.2.1.2.2.1.20
        type: counter
        help: "The number of outbound packets that contained errors"
        indexes:
          - labelname: ifIndex
            type: Integer32

