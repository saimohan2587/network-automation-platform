# ==============================================================================
# Observability Staging Environment Profile (GNS3 Staging - 3 Devices)
# ==============================================================================
ENVIRONMENT=staging
PROMETHEUS_SCRAPE_INTERVAL=30s
PROMETHEUS_SCRAPE_TIMEOUT=25s
PROMETHEUS_TSDB_RETENTION_TIME=30d
PROMETHEUS_TSDB_RETENTION_SIZE=10GB

SNMP_EXPORTER_WORKERS=4
LOKI_RETENTION_PERIOD=720h
ALERTMANAGER_REPEAT_INTERVAL=4h

# Resource Allocation (Lab Host)
PROMETHEUS_MEM_LIMIT=1024M
LOKI_MEM_LIMIT=512M
GRAFANA_MEM_LIMIT=512M
