# ==============================================================================
# Observability Production Environment Profile (Enterprise - 1000+ Devices)
# ==============================================================================
ENVIRONMENT=production
PROMETHEUS_SCRAPE_INTERVAL=30s
PROMETHEUS_SCRAPE_TIMEOUT=25s
PROMETHEUS_TSDB_RETENTION_TIME=90d
PROMETHEUS_TSDB_RETENTION_SIZE=100GB

SNMP_EXPORTER_WORKERS=64
LOKI_RETENTION_PERIOD=2160h
ALERTMANAGER_REPEAT_INTERVAL=4h

# High-Availability & Scale Settings
PROMETHEUS_SHARDS=4
ALERTMANAGER_HA_CLUSTER=true
LOKI_STORAGE_BACKEND=s3

# Resource Allocation (Production Node)
PROMETHEUS_MEM_LIMIT=8192M
LOKI_MEM_LIMIT=4096M
GRAFANA_MEM_LIMIT=2048M
